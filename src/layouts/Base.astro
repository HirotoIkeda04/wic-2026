---
/**
 * Document shell for the wic.ihiro.page mirror: <head> metadata only. The
 * page body is a React tree from src/wic, copied from the JPSI site.
 */
import '../styles/global.css';
import { JPSI_URL, SITE } from '../wic/data';
import { OG_IMAGE, type WicHead } from '../wic/routes';

type Props = WicHead;
const { title, description, path } = Astro.props;
// The official copy on the JPSI site is canonical; this mirror is not.
const canonical = `${JPSI_URL}/wic${path === '/' ? '' : path}`;
const ogImage = new URL(OG_IMAGE.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141414" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.organizer.en} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/jpsi-icon.png" type="image/png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="JPSI" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content="World Investment Competition 2026" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
