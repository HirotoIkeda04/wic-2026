---
/** Light text page: back link, title, lead, article body, pager, footer. */
import Base from './Base.astro';
import Pager from '../components/Pager.astro';
import { SITE } from '../data/site';

interface Props { slug: string; title: string; lead: string; description?: string }
const { slug, title, lead, description = lead } = Astro.props;
---

<Base title={`${title} — World Investment Competition 2026`} ogTitle={`${title} — WIC 2026`} description={description}>
  <div class="grain" aria-hidden="true"></div>
  <main class="relative z-10 mx-auto max-w-[42rem] px-5 pb-20 pt-[calc(env(safe-area-inset-top,0px)+6.5rem)] text-[17px] leading-[1.6]">
    <a href="/" class="-ml-[0.2em] inline-flex min-h-11 items-center gap-[0.3em] text-[0.95rem] font-medium text-ink no-underline hover:underline hover:underline-offset-[0.2em]">
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="flex-none"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>Back
    </a>
    <h1 class="mb-3 mt-2.5 text-[clamp(2.2rem,8vw,3.2rem)] font-light leading-[1.05] tracking-[-0.02em]">{title}</h1>
    <p class="mb-10 text-[1.15rem] leading-[1.55] text-muted">{lead}</p>
    <div class="article"><slot /></div>
    <Pager slug={slug} />
  </main>
  <footer class="relative z-10 mx-auto max-w-[42rem] px-5 pb-[calc(env(safe-area-inset-bottom,0px)+2.5rem)] text-[0.9rem] text-muted">
    <p>This page reflects the participant guide dated {SITE.guideDate}. Details marked TBC will be announced later. © JPSI</p>
  </footer>
</Base>

<script>
  // Detail pages always open at the top. The landing page passes its scroll
  // position as ?y=, which we forward to every internal link so "Back"
  // returns to the same spot in the animation.
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  const t0 = performance.now();
  (function hold() {
    if (window.scrollY > 2) window.scrollTo(0, 0);
    if (performance.now() - t0 < 700) requestAnimationFrame(hold);
  })();
  window.addEventListener('load', () => window.scrollTo(0, 0));
  const m = /[?&]y=(\d+)/.exec(location.search);
  if (m) {
    document.querySelectorAll<HTMLAnchorElement>('a[href^="/"]').forEach((a) => { a.href = a.getAttribute('href') + '?y=' + m[1]; });
    try { history.replaceState(null, '', location.pathname); } catch {}
  }
</script>
