---
import Base from '../layouts/Base.astro';
import { Landing } from '../wic/Landing';
import { landingHead } from '../wic/routes';
---

<!-- The island is Landing itself, not WicLanding from routes.tsx: that module
     also imports the five detail pages, which would end up in the landing's bundle. -->
<Base {...landingHead('en')}>
  <Landing lang="en" client:load />
</Base>
