---
/**
 * Fixed header + full-screen menu overlay. Colors come from the tone tokens
 * (see global.css), so the same component sits on the dark landing page and
 * the light detail pages.
 */
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname;
---

<header
  class="site-header pointer-events-none fixed inset-x-0 top-0 z-50 flex items-center justify-between px-[1.1rem] pb-[0.9rem] pt-[calc(env(safe-area-inset-top,0px)+0.9rem)] *:pointer-events-auto"
>
  <a href="/" class="inline-flex items-center gap-[0.45rem] leading-none text-ink no-underline" aria-label={SITE.shortName} data-brand>
    <span class="text-[2.05rem] font-black leading-[0.8] tracking-[-0.045em]">WIC</span>
    <span class="text-[0.66rem] font-extrabold uppercase leading-[1.08] tracking-[0.01em]">World Investment<br />Competition 2026</span>
  </a>
  <div class="flex items-center gap-[0.6rem]">
    <a href={SITE.entryUrl} class="inline-flex h-9 items-center rounded-full bg-ink px-6 text-[0.95rem] font-semibold text-bg no-underline">Entry</a>
    <button
      id="menuBtn"
      type="button"
      class="group grid size-9 cursor-pointer place-items-center rounded-full border border-ink/45 bg-bg/50 text-ink backdrop-blur-[6px]"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav"
    >
      <span class="relative block h-px w-4 bg-current transition-[background,transform] duration-250 group-aria-expanded:bg-transparent before:absolute before:left-0 before:-top-[5px] before:block before:h-px before:w-4 before:bg-current before:transition-transform before:duration-250 before:content-[''] after:absolute after:left-0 after:top-[5px] after:block after:h-px after:w-4 after:bg-current after:transition-transform after:duration-250 after:content-[''] group-aria-expanded:before:translate-y-[5px] group-aria-expanded:before:rotate-45 group-aria-expanded:after:-translate-y-[5px] group-aria-expanded:after:-rotate-45"></span>
    </button>
  </div>
</header>

<nav
  id="nav"
  aria-label="Menu"
  class="fixed inset-0 z-40 hidden flex-col overflow-y-auto bg-bg/95 pt-[calc(env(safe-area-inset-top,0px)+4.6rem)] text-right backdrop-blur-[10px] data-open:flex"
>
  <div class="flex-none px-6 pb-[1.4rem]">
    {NAV.map((item) => (
      <a
        href={item.href}
        aria-current={path.startsWith(item.href) ? 'page' : undefined}
        class="block border-b border-line py-[0.45em] text-[1.25rem] text-ink no-underline last:border-b-0 aria-[current=page]:font-semibold"
      >{item.label}</a>
    ))}
  </div>
  <div class="mt-auto flex-none border-t border-line px-6 pb-[calc(env(safe-area-inset-bottom,0px)+1.2rem)] pt-[1.3rem] text-[0.84rem] leading-[1.55] text-ink/70 [&_b]:mb-[0.35rem] [&_b]:block [&_b]:text-ink">
    <p class="mb-[0.9rem]"><b>Organizer</b>{SITE.organizer}<br />AI Agent division co-host: {SITE.coHost}</p>
    <p class="mb-[0.9rem]"><b>Contact</b>{SITE.contact.map((c) => (
      <a href={c.href} class="ml-[1.1em] border-b border-ink/35 text-ink no-underline">{c.label}</a>
    ))}</p>
    <p class="text-[0.74rem] text-ink/45">{SITE.legal}</p>
  </div>
</nav>

<script>
  const btn = document.getElementById('menuBtn')!;
  const nav = document.getElementById('nav')!;
  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    nav.toggleAttribute('data-open', open);
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).tagName === 'A') setOpen(false); });
</script>
